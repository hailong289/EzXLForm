# Environment variables for Vite
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
# Khóa mã hóa phiên Google trong SQLite. Để trống thì phiên chỉ giữ trong tab đang mở.
VITE_GOOGLE_TOKEN_KEY=
# Client secret của OAuth client Web. Cần để đổi mã đăng nhập lấy refresh token.
VITE_GOOGLE_CLIENT_SECRET=
    
# Azure app registration loại SPA, redirect đúng origin
VITE_MICROSOFT_CLIENT_ID=

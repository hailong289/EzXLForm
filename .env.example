# Biến cho bản web. Không commit giá trị thật.

# Google Cloud: OAuth client loại Web. Không cần API key.
# Origin gồm http://localhost:5173 và domain Vercel.
# Lần đăng nhập sẽ xin quyền xem và sửa file trên Google Drive.
VITE_GOOGLE_CLIENT_ID=

